{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Place this app in **nextcloud/apps/**",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite --configLoader runner --mode production build",
    "dev": "vite --configLoader runner --mode development build",
    "watch": "vite --configLoader runner --mode development build --watch",
    "test": "jest",
    "lint": "eslint --ext .js,.vue src",
    "stylelint": "stylelint src/css/*.css src/**/*.vue",
    "stylelint:fix": "stylelint src/css/*.css src/**/*.vue --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arawa/workspace.git"
  },
  "keywords": [],
  "author": "Arawa <https://www.arawa.fr/>",
  "contributors": [
    {
      "name": "Baptiste Fotia",
      "email": "baptiste.fotia@arawa.fr"
    },
    {
      "name": "Cyrille Bollu",
      "email": "cyrille@bollu.be"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/arawa/workspace/issues"
  },
  "homepage": "https://github.com/arawa/workspace#readme",
  "engines": {
    "npm": "^11.3.0",
    "node": "^24.0.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@mdi/js": "^7.4.47",
    "@nextcloud/babel-config": "^1.2.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.1.0",
    "@nextcloud/vite-config": "^2.5.4",
    "@vue/compiler-dom": "^3.4.21",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^30.5.2",
    "core-js": "^3.50.0",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-mock-axios": "^4.9.0",
    "jest-serializer-vue": "^3.1.0",
    "jsdom": "^30.1.1",
    "jsdom-global": "^3.0.2",
    "prettier": "^3.9.9",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.106.1",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@jambonn/vue-lazyload": "^1.0.10",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/files": "^4.1.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.4.0",
    "@vueuse/components": "^14.1.0",
    "debounce": "^3.0.0",
    "ramda": "^0.30.1",
    "vue": "^3.5.29",
    "vue-material-design-icons": "^5.2.0",
    "vue-router": "^5.3.1",
    "vuex": "^4.1.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "vue",
      "mjs"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less)$": "identity-obj-proxy",
      "^uuid$": "<rootDir>/node_modules/uuid/dist/index.js",
      "^(.*)\\.svg\\?raw$": "<rootDir>/src/tests/__mocks__/svgRawMock.js",
      "^@nextcloud/dialogs$": "<rootDir>/src/tests/__mocks__/nextcloudDialogsMock.js",
      "^@nextcloud/files/dav$": "<rootDir>/src/tests/__mocks__/nextcloudFilesMock.js",
      "^@nextcloud/vue/components/(.*)$": "<rootDir>/src/tests/__mocks__/nextcloudVueComponentMock.js",
      "^@nextcloud/vue/composables/useIsDarkTheme$": "<rootDir>/src/tests/__mocks__/useIsDarkThemeMock.js",
      "^@nextcloud/axios$": "<rootDir>/src/tests/__mocks__/axios.js"
    },
    "snapshotSerializers": [
      "<rootDir>/node_modules/jest-serializer-vue"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nextcloud|@ckeditor|splitpanes|debounce)).+\\.js$"
    ],
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "transform": {
      ".*\\.m?js$": "babel-jest",
      ".*\\.(vue)$": "@vue/vue3-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/splitpanes"
    ],
    "setupFiles": [
      "<rootDir>/src/tests/jest.setup.js"
    ]
  }
}
